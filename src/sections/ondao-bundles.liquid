{% liquid
  assign section_id = 'ondao-bundles-' | append: section.id
%}

<section id="{{ section_id }}" class="ondao-bundles" aria-labelledby="{{ section_id }}-heading">
  <div class="ondao-bundles__inner">
    <header class="ondao-bundles__header">
      <p class="ondao-bundles__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="{{ section_id }}-heading" class="ondao-bundles__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.intro != blank %}
        <div class="ondao-bundles__intro">{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    <div class="ondao-bundles__vip" role="note">
      <span class="ondao-bundles__vip-mark" aria-hidden="true">✳</span>
      <div class="ondao-bundles__vip-copy">
        <p class="ondao-bundles__vip-title">{{ section.settings.vip_title | escape }}</p>
        {% if section.settings.vip_copy != blank %}
          <p class="ondao-bundles__vip-description">{{ section.settings.vip_copy | escape }}</p>
        {% endif %}
      </div>
      {% if section.settings.vip_link != blank %}
        <a class="ondao-bundles__vip-link" href="{{ section.settings.vip_link }}">
          {{ section.settings.vip_link_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="ondao-bundles__grid">
        {% for block in section.blocks %}
          {% assign bundle_product = block.settings.product %}
          <article class="ondao-bundles__card" {{ block.shopify_attributes }}>
            <div class="ondao-bundles__image-wrap">
              {% if bundle_product != blank and bundle_product.featured_image != blank %}
                {{ bundle_product.featured_image | image_url: width: 1000 | image_tag: class: 'ondao-bundles__image', loading: 'lazy', widths: '360, 540, 720, 900, 1000', sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw', alt: bundle_product.featured_image.alt | default: bundle_product.title | escape }}
              {% else %}
                <div class="ondao-bundles__image-placeholder" aria-hidden="true">
                  <span>ONDÃO</span>
                  <span>LOTE 001</span>
                </div>
              {% endif %}
              <span class="ondao-bundles__edition">{{ block.settings.edition | escape }}</span>
            </div>

            <div class="ondao-bundles__details">
              {% if block.settings.kicker != blank %}
                <p class="ondao-bundles__kicker">{{ block.settings.kicker | escape }}</p>
              {% endif %}
              <h3 class="ondao-bundles__product-title">
                {% if bundle_product != blank %}
                  <a href="{{ bundle_product.url }}">{{ block.settings.title | default: bundle_product.title | escape }}</a>
                {% else %}
                  {{ block.settings.title | default: 'Bundle Ondão' | escape }}
                {% endif %}
              </h3>
              {% if block.settings.description != blank %}
                <p class="ondao-bundles__description">{{ block.settings.description | escape }}</p>
              {% elsif bundle_product != blank and bundle_product.description != blank %}
                <div class="ondao-bundles__description">{{ bundle_product.description | strip_html | truncate: 120 | escape }}</div>
              {% endif %}

              <div class="ondao-bundles__purchase">
                {% if bundle_product != blank %}
                  <div class="ondao-bundles__price" aria-label="Preço">
                    {% if bundle_product.compare_at_price > bundle_product.price %}
                      <s class="ondao-bundles__compare-price">{{ bundle_product.compare_at_price | money }}</s>
                    {% endif %}
                    <span>{{ bundle_product.price | money }}</span>
                  </div>
                  {% form 'product', bundle_product, class: 'ondao-bundles__form' %}
                    <input type="hidden" name="id" value="{{ bundle_product.selected_or_first_available_variant.id }}">
                    <button
                      class="ondao-bundles__button"
                      type="submit"
                      name="add"
                      {% unless bundle_product.selected_or_first_available_variant.available %}disabled{% endunless %}
                    >
                      {% if bundle_product.selected_or_first_available_variant.available %}
                        {{ section.settings.button_label | escape }}
                      {% else %}
                        {{ section.settings.sold_out_label | escape }}
                      {% endif %}
                      <span aria-hidden="true">&rarr;</span>
                    </button>
                  {% endform %}
                {% else %}
                  <p class="ondao-bundles__setup-note">Seleciona um produto para este bundle no editor do tema.</p>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.footer_note != blank %}
      <p class="ondao-bundles__footer-note">{{ section.settings.footer_note | escape }}</p>
    {% endif %}
  </div>
</section>

{% style %}
  #{{ section_id }} {
    --ob-paper: {{ section.settings.background }};
    --ob-card: {{ section.settings.card_background }};
    --ob-ink: {{ section.settings.text_color }};
    --ob-muted: {{ section.settings.muted_color }};
    --ob-gold: {{ section.settings.accent_color }};
    background: var(--ob-paper);
    color: var(--ob-ink);
    padding: clamp(3.5rem, 7vw, 7rem) 1.25rem;
  }

  #{{ section_id }} .ondao-bundles__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  #{{ section_id }} .ondao-bundles__header {
    max-width: 760px;
    margin: 0 auto 2.75rem;
    text-align: center;
  }

  #{{ section_id }} .ondao-bundles__eyebrow,
  #{{ section_id }} .ondao-bundles__kicker {
    margin: 0 0 0.8rem;
    color: var(--ob-gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #{{ section_id }} .ondao-bundles__heading {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 400;
    line-height: 1.08;
  }

  #{{ section_id }} .ondao-bundles__intro {
    max-width: 560px;
    margin: 1rem auto 0;
    color: var(--ob-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  #{{ section_id }} .ondao-bundles__intro p {
    margin: 0;
  }

  #{{ section_id }} .ondao-bundles__vip {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 960px;
    margin: 0 auto 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--ob-gold) 55%, transparent);
    background: color-mix(in srgb, var(--ob-card) 78%, var(--ob-gold));
  }

  #{{ section_id }} .ondao-bundles__vip-mark {
    flex: 0 0 auto;
    color: var(--ob-gold);
    font-size: 1.35rem;
  }

  #{{ section_id }} .ondao-bundles__vip-copy {
    flex: 1 1 auto;
  }

  #{{ section_id }} .ondao-bundles__vip-title,
  #{{ section_id }} .ondao-bundles__vip-description {
    margin: 0;
  }

  #{{ section_id }} .ondao-bundles__vip-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.12rem;
  }

  #{{ section_id }} .ondao-bundles__vip-description {
    margin-top: 0.2rem;
    color: var(--ob-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  #{{ section_id }} .ondao-bundles__vip-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    color: var(--ob-ink);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration-color: var(--ob-gold);
    text-underline-offset: 0.25rem;
  }

  #{{ section_id }} .ondao-bundles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  #{{ section_id }} .ondao-bundles__card {
    min-width: 0;
    background: var(--ob-card);
  }

  #{{ section_id }} .ondao-bundles__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 4.6;
    background: color-mix(in srgb, var(--ob-paper) 75%, var(--ob-gold));
  }

  #{{ section_id }} .ondao-bundles__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  #{{ section_id }} .ondao-bundles__card:hover .ondao-bundles__image {
    transform: scale(1.035);
  }

  #{{ section_id }} .ondao-bundles__image-placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--ob-gold);
    font-family: Georgia, 'Times New Roman', serif;
    letter-spacing: 0.08em;
  }

  #{{ section_id }} .ondao-bundles__image-placeholder span:last-child {
    font-family: inherit;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
  }

  #{{ section_id }} .ondao-bundles__edition {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.45rem 0.6rem;
    background: var(--ob-card);
    color: var(--ob-ink);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #{{ section_id }} .ondao-bundles__details {
    padding: 1.35rem 1.35rem 1.5rem;
  }

  #{{ section_id }} .ondao-bundles__kicker {
    margin-bottom: 0.45rem;
    font-size: 0.62rem;
  }

  #{{ section_id }} .ondao-bundles__product-title {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.2;
  }

  #{{ section_id }} .ondao-bundles__product-title a {
    color: inherit;
    text-decoration: none;
  }

  #{{ section_id }} .ondao-bundles__product-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ob-gold);
    text-underline-offset: 0.2rem;
  }

  #{{ section_id }} .ondao-bundles__description {
    min-height: 2.8em;
    margin: 0.65rem 0 1.25rem;
    color: var(--ob-muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  #{{ section_id }} .ondao-bundles__purchase {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ob-gold) 30%, transparent);
  }

  #{{ section_id }} .ondao-bundles__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  #{{ section_id }} .ondao-bundles__compare-price {
    color: var(--ob-muted);
    font-size: 0.78rem;
    font-weight: 400;
  }

  #{{ section_id }} .ondao-bundles__form {
    margin: 0;
  }

  #{{ section_id }} .ondao-bundles__button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--ob-ink);
    background: var(--ob-ink);
    color: var(--ob-card);
    cursor: pointer;
    font: inherit;
    font-size: 0.73rem;
    font-weight: 700;
    transition: background-color 180ms ease, color 180ms ease;
  }

  #{{ section_id }} .ondao-bundles__button:hover:not(:disabled) {
    background: transparent;
    color: var(--ob-ink);
  }

  #{{ section_id }} .ondao-bundles__button:focus-visible,
  #{{ section_id }} .ondao-bundles__vip-link:focus-visible,
  #{{ section_id }} .ondao-bundles__product-title a:focus-visible {
    outline: 2px solid var(--ob-gold);
    outline-offset: 3px;
  }

  #{{ section_id }} .ondao-bundles__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  #{{ section_id }} .ondao-bundles__setup-note {
    margin: 0;
    color: var(--ob-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  #{{ section_id }} .ondao-bundles__footer-note {
    margin: 1.5rem 0 0;
    color: var(--ob-muted);
    font-size: 0.74rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 850px) {
    #{{ section_id }} .ondao-bundles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .ondao-bundles__card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    #{{ section_id }} .ondao-bundles__card:last-child:nth-child(odd) .ondao-bundles__image-wrap {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 560px) {
    #{{ section_id }} {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    #{{ section_id }} .ondao-bundles__header {
      margin-bottom: 2rem;
    }

    #{{ section_id }} .ondao-bundles__vip {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0.65rem 0.8rem;
      margin-bottom: 1.5rem;
      padding: 0.9rem;
    }

    #{{ section_id }} .ondao-bundles__vip-copy {
      flex-basis: calc(100% - 2.5rem);
    }

    #{{ section_id }} .ondao-bundles__vip-link {
      margin-left: 2.15rem;
    }

    #{{ section_id }} .ondao-bundles__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    #{{ section_id }} .ondao-bundles__card:last-child:nth-child(odd) {
      grid-column: auto;
    }

    #{{ section_id }} .ondao-bundles__card:last-child:nth-child(odd) .ondao-bundles__image-wrap {
      aspect-ratio: 4 / 4.6;
    }

    #{{ section_id }} .ondao-bundles__image-wrap {
      aspect-ratio: 4 / 3.5;
    }

    #{{ section_id }} .ondao-bundles__details {
      padding: 1.1rem 1rem 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .ondao-bundles__image,
    #{{ section_id }} .ondao-bundles__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Ondão | Bundles",
  "tag": "section",
  "class": "section-ondao-bundles",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Ondão · objetos com intenção"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lote 001. Feito para oferecer."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introdução",
      "default": "<p>Peças escolhidas com tempo, matéria e detalhe. Descobre os bundles de edição limitada Ondão.</p>"
    },
    {
      "type": "text",
      "id": "vip_title",
      "label": "Título do destaque VIP",
      "default": "Desconto VIP"
    },
    {
      "type": "textarea",
      "id": "vip_copy",
      "label": "Texto do destaque VIP",
      "default": "Descobre as condições especiais disponíveis para o Lote 001."
    },
    {
      "type": "url",
      "id": "vip_link",
      "label": "Ligação para condições VIP"
    },
    {
      "type": "text",
      "id": "vip_link_label",
      "label": "Texto da ligação VIP",
      "default": "Ver condições"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Adicionar"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Texto para produto indisponível",
      "default": "Esgotado"
    },
    {
      "type": "textarea",
      "id": "footer_note",
      "label": "Nota no final da secção",
      "default": ""
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo da secção",
      "default": "#F4EFE4"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fundo dos bundles",
      "default": "#FFFCF6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto principal",
      "default": "#263129"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texto secundário",
      "default": "#68685D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Destaque dourado",
      "default": "#A78045"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto do bundle"
        },
        {
          "type": "text",
          "id": "edition",
          "label": "Edição",
          "default": "Lote 001"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Linha de destaque",
          "default": "Feito em pequena escala"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado",
          "info": "Deixa em branco para usar o título do produto."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descrição personalizada",
          "info": "Deixa em branco para usar a descrição do produto."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Ondão | Bundles",
      "blocks": [
        { "type": "bundle" },
        { "type": "bundle" },
        { "type": "bundle" }
      ]
    }
  ]
}
{% endschema %}
