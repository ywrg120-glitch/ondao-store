{%- comment -%} Fecho comum das páginas: "Pronto para a sua onda?" com o botão de compra. {%- endcomment -%}
{%- assign p = all_products['creme-finalizador-para-pentear-com-oleo-de-cacay'] -%}
<section class="pg-cta">
  <div class="wrap estreito">
    <h2 class="h2">Pronto para a sua <em class="it">onda?</em></h2>
    {%- if p != blank and p.selected_or_first_available_variant.available -%}
      {%- assign pv = p.selected_or_first_available_variant -%}
      <a class="btn btn-verde" href="/cart/{{ pv.id }}:1">Quero o meu ondão · {{ pv.price | money_without_currency }}&nbsp;€</a>
      <p class="pg-cta-nota">Portes grátis em Portugal a partir de 35&nbsp;€ · envio em até 10 dias</p>
    {%- else -%}
      {%- capture cta_link -%}{% render 'ondao-cta-link' %}{%- endcapture -%}<a class="btn btn-verde" href="{{ cta_link }}">Quero o meu ondão</a>
    {%- endif -%}
    <a class="pg-voltar" href="{{ routes.root_url }}">Ver o creme</a>
  </div>
</section>
