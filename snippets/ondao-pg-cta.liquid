{%- comment -%} Fecho comum das páginas: "Pronto para a sua onda?" com o botão de compra. {%- endcomment -%}
{%- assign p = all_products['creme-finalizador-para-pentear-com-oleo-de-cacay'] -%}
<section class="pg-cta">
  <div class="wrap estreito">
    <h2 class="h2">{{ 'ondao.cta.titulo_html' | t }}</h2>
    {%- if p != blank and p.selected_or_first_available_variant.available -%}
      {%- assign pv = p.selected_or_first_available_variant -%}
      <a class="btn btn-verde" href="/cart/{{ pv.id }}:1" data-carrinho-add>{{ 'ondao.geral.adicionar' | t }} · {{ pv.price | money_without_currency }}&nbsp;€</a>
      <p class="pg-cta-nota">{{ 'ondao.cta.nota' | t }}</p>
    {%- else -%}
      {%- capture cta_link -%}{% render 'ondao-cta-link' %}{%- endcapture -%}<a class="btn btn-verde" href="{{ cta_link }}">{{ 'ondao.cta.quero' | t }}</a>
    {%- endif -%}
    <a class="pg-voltar" href="{{ routes.root_url }}">{{ 'ondao.geral.ver_creme' | t }}</a>
  </div>
</section>
