{%- unless section.settings.vista == 'creme' -%}
<section class="secao" id="ingredientes">
  <div class="wrap">
    <div class="cabeca">
      <span class="caps" style="color:var(--terra)">O que está dentro</span>
      <h2 class="h2">Cinco ativos. <em class="it">Zero enchimento.</em></h2>
