        <div class="slide contem" data-legenda="O tubo"><img width="928" height="1152" src="{{ 'tubo-frente-v2.jpg' | asset_url }}" alt="Tubo ondão de frente"></div>
        <div class="slide" data-legenda="A textura"><img width="928" height="1152" src="{{ 'galeria-textura.jpg' | asset_url }}" alt="Textura sedosa do creme ondão espalhada sobre ardósia" loading="lazy"></div>
        <div class="slide" data-legenda="Os ingredientes"><img width="928" height="1152" src="{{ 'galeria-tubo-ingredientes.jpg' | asset_url }}" alt="Tubo ondão sobre ardósia com nozes de Cacay, cápsulas de Sacha Inchi e óleo" loading="lazy"></div>
        <div class="slide" data-legenda="Em uso"><img width="928" height="1152" src="{{ 'galeria-em-uso-v2.jpg' | asset_url }}" alt="Mulher de caracóis definidos com o tubo ondão numa mão e uma porção de creme na palma da outra" loading="lazy"></div>
        <div class="slide" data-legenda="O ritual"><img width="928" height="1152" src="{{ 'galeria-ritual.jpg' | asset_url }}" alt="Tubo ondão numa prateleira de travertino com pente de madeira e toalha de linho" loading="lazy"></div>
