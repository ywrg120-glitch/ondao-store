{%- liquid
  if product
    assign p = product
  elsif section.settings.produto != blank
    assign p = section.settings.produto
  else
    assign p = all_products['creme-finalizador-para-pentear-com-oleo-de-cacay']
  endif
  assign cta_link = '/pages/lista'
  if p != blank
    assign v = p.selected_or_first_available_variant
    if v.available
      assign cta_link = '/cart/' | append: v.id | append: ':1'
    endif
  endif
-%}
<script>
  window.ONDAO_CONFIG = {
    {%- if p != blank %}
    PRECO: {{ v.price | divided_by: 100.0 | json }},
    {%- if v.available %}
    LINK_COMPRA: {{ request.origin | append: '/cart/' | append: v.id | append: ':1' | json }},
    {%- endif %}
    {%- endif %}
    DIAS_PREPARACAO: {{ section.settings.dias_preparacao | json }},
    DIAS_DEVOLUCAO: {{ section.settings.dias_devolucao | json }}
  };
</script>

<!-- HERO: um ecrã — modelo, selo USP, produto, promessa, 3 benefícios, prova social, CTA -->
{%- unless section.settings.vista == 'creme' -%}
<section class="hero" id="topo">
  <div class="wrap hero-in">
    <div class="cena">
      <img width="1024" height="1024" class="foto-hero" src="{{ 'hero-ingredientes.webp' | asset_url }}" alt="Tubo ondão sobre travertino com os ingredientes da fórmula: Cacay, Sacha Inchi, Ungurahui, quinoa e uma gota de gel" fetchpriority="high" onerror="this.onerror=null;this.src='{{ 'hero-ingredientes.jpg' | asset_url }}'">
    </div>
    <div class="oferta">
      <h1 class="promessa">Defina a sua <em>onda.</em></h1>
      <ul class="usps">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3.5 4.2 5.5 7.4 5.5 10.2a5.5 5.5 0 0 1-11 0C6.5 10.4 8.5 7.2 12 3z"/><path d="M9.5 14.5a2.6 2.6 0 0 0 2.5 2.4"/></svg><span><b>Óleo de Cacay</b>da Colômbia</span></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 2.5-1.5 3-2"/><path d="M3 13c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 2.5-1.5 3-2"/><path d="M3 18c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 2.5-1.5 3-2"/></svg><span><b>Define sem pesar</b>e controla o frizz</span></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8.5" cy="8" r="3"/><circle cx="16" cy="8.5" r="2.6"/><path d="M3 19.5c.6-3.3 2.8-5.3 5.5-5.3s4.9 2 5.5 5.3M14.6 14.4c.5-.1.9-.2 1.4-.2 2.4 0 4.3 1.8 4.9 4.8"/></svg><span><b>Para ela e ele</b>ondas a crespos</span></li>
      </ul>
      <p class="prova" id="prova" hidden><span class="ponto" aria-hidden="true"></span><span id="prova-txt"></span></p>
      <a href="{{ cta_link }}" class="btn cta-hero" id="cta-hero">Quero o meu ondão <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
{%- endunless -%}

<div class="faixa">
  <div class="wrap"><p>Definição que se vê. Leveza que se sente.</p></div>
</div>

<!-- PRODUTO -->
