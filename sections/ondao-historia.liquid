          <text class="meio" x="372" y="262" text-anchor="middle">um oceano de distância</text>
          <text class="lugar" x="489.6" y="46.7" text-anchor="end">Portugal</text>
          <text class="sub" x="489.6" y="70.7" text-anchor="end">onde nasce a ondão</text>
          <text class="lugar" x="123.5" y="372.9">Colômbia</text>
          <text class="sub" x="123.5" y="396.9">onde tudo começou</text>
