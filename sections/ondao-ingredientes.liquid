<section class="secao pg" id="ingredientes">
  <div class="wrap">
    <div class="cabeca">
      <h1 class="h2">Cinco ativos. <em class="it">Zero enchimento.</em></h1>
      <p class="ing-dica">Escolha um ativo para conhecer a origem e o que faz no seu cabelo.</p>
    </div>
    <div class="ing-grid">
      <div class="heroi" id="ing-heroi" aria-live="polite">
        <div class="foto"><img width="1248" height="848" src="{{ 'IMG_4142.jpeg' | asset_url }}" alt="Nozes de Cacay abertas e óleo dourado sobre ardósia" loading="lazy"></div>
        <div class="txt">
          <span class="palavra">Cacay.</span>
          <span class="latim">Caryodendron orinocense · bacia do Orinoco, Colômbia</span>
          <p class="corpo">O óleo de uma noz que as comunidades da Orinoquía conhecem há gerações. Rico em vitamina E e ácido linoleico: nutre a fibra e dá brilho sem deixar o caracol pesado.</p>
          <div class="funcao"><b>Na fórmula</b><span>O ativo principal. Nutre e dá brilho com um toque seco, sem efeito oleoso.</span></div>
        </div>
      </div>
      <div class="ings">
        <button class="ing" type="button" data-ing="sacha-inchi"><span class="mais" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><img src="{{ 'ing-sacha-inchi.jpg' | asset_url }}" alt="Cápsulas em estrela de Sacha Inchi, sementes e óleo claro sobre ardósia" loading="lazy" width="640" height="640"><div class="ing-txt"><span class="ing-nome">Óleo de Sacha Inchi</span><span class="origem">Amazónia colombiana</span><p>Ultraleve e rico em ómega-3. Brilho sem peso.</p></div></button>
        <button class="ing" type="button" data-ing="ungurahui"><span class="mais" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><img src="{{ 'ing-ungurahui.jpg' | asset_url }}" alt="Frutos roxos de Ungurahui e óleo verde-dourado sobre ardósia" loading="lazy" width="640" height="640"><div class="ing-txt"><span class="ing-nome">Óleo de Ungurahui</span><span class="origem">Amazónia colombiana</span><p>Usado há gerações no cuidado do cabelo. Brilho e suavidade.</p></div></button>
        <button class="ing" type="button" data-ing="quinoa"><span class="mais" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><img src="{{ 'ing-quinoa.jpg' | asset_url }}" alt="Grãos de quinoa, espiga seca e proteína em pó sobre ardósia" loading="lazy" width="640" height="640"><div class="ing-txt"><span class="ing-nome">Proteína de Quinoa</span><span class="origem">Andes</span><p>Estrutura e elasticidade para o caracol.</p></div></button>
        <button class="ing" type="button" data-ing="poliglutamico"><span class="mais" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><img src="{{ 'ing-poliglutamico.jpg' | asset_url }}" alt="Gel transparente a escorrer de uma pipeta para uma taça de cerâmica" loading="lazy" width="640" height="640"><div class="ing-txt"><span class="ing-nome">Ácido Poliglutâmico</span><span class="origem">Biotecnologia</span><p>Retém a hidratação. Menos frizz.</p></div></button>
      </div>
    </div>
  </div>
</section>
{% render 'ondao-pg-cta' %}
<script>window.ONDAO_ASSET_BASE = {{ 'ondao-paginas.js' | asset_url | split: 'ondao-paginas.js' | first | json }};</script>
<script src="{{ 'ondao-paginas.js' | asset_url }}" defer></script>

{% schema %}
{"name": "Ingredientes ondão", "settings": [], "presets": [{"name": "Ingredientes ondão"}]}
{% endschema %}
