{%- liquid
  assign cta_p = all_products['creme-finalizador-para-pentear-com-oleo-de-cacay']
  assign cta_link = routes.root_url | append: '/pages/lista' | replace: '//', '/'
  assign cta_txt = 'ondao.geral.adicionar' | t
  if cta_p != blank
    assign cta_v = cta_p.selected_or_first_available_variant
    if cta_v.available
      assign cta_link = '/cart/' | append: cta_v.id | append: ':1'
    endif
  endif
-%}
<div class="anuncio" aria-label="Avisos">
  <div class="trilho">
    {%- if cta_v and cta_v.available -%}
      {%- assign av2 = '' -%}{%- assign av3 = 'ondao.aviso.devolver' | t -%}
    {%- else -%}
      {%- assign av2 = 'ondao.aviso.pre_venda' | t -%}{%- assign av3 = 'ondao.aviso.ue' | t -%}
    {%- endif -%}
    <span>{{ 'ondao.aviso.portes' | t }}</span>{% if av2 != blank %}<span>{{ av2 }}</span>{% endif %}<span>{{ av3 }}</span>
    <span aria-hidden="true">{{ 'ondao.aviso.portes' | t }}</span>{% if av2 != blank %}<span aria-hidden="true">{{ av2 }}</span>{% endif %}<span aria-hidden="true">{{ av3 }}</span>
  </div>
</div>

<header>
  <div class="wrap nav">
    <div>
      <button class="ico-btn" id="btn-menu" type="button" aria-label="{{ 'ondao.nav.abrir_menu' | t }}" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <nav class="links" aria-label="{{ 'ondao.nav.principal' | t }}">
        <a href="{% render 'ondao-r' %}pages/creme">{{ 'ondao.nav.creme' | t }}</a>
        <a href="{% render 'ondao-r' %}pages/ingredientes">{{ 'ondao.nav.ingredientes' | t }}</a>
        <a href="{% render 'ondao-r' %}pages/historia">{{ 'ondao.nav.historia' | t }}</a>
        <a href="{% render 'ondao-r' %}pages/faq">{{ 'ondao.nav.faq' | t }}</a>
      </nav>
    </div>
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ 'ondao.nav.inicio' | t }}">ondão</a>
    <div class="nav-dir">
      <a class="btn btn-verde nav-cta" id="nav-cta" href="{{ cta_link }}" {% if cta_link contains '/cart/' %}data-carrinho-add{% endif %}>{{ cta_txt }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="ico-btn ico-saco" href="{{ routes.cart_url }}" data-carrinho-abrir aria-label="{{ 'ondao.nav.carrinho_n' | t: count: cart.item_count }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        {%- if cart.item_count > 0 -%}<span class="saco-n" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
  <div class="menu" id="menu">
    <div class="wrap">
      <ul>
        <li><a href="{% render 'ondao-r' %}pages/creme">{{ 'ondao.nav.creme' | t }}</a></li>
        <li><a href="{% render 'ondao-r' %}pages/ingredientes">{{ 'ondao.nav.ingredientes' | t }}</a></li>
        <li><a href="{% render 'ondao-r' %}pages/historia">{{ 'ondao.nav.historia' | t }}</a></li>
        <li><a href="{% render 'ondao-r' %}pages/faq">{{ 'ondao.nav.perguntas' | t }}</a></li>
        <li><a href="{% render 'ondao-r' %}pages/lista">{{ 'ondao.nav.newsletter' | t }}</a></li>
      </ul>
    </div>
  </div>
</header>
<script>
(function(){
  var btn = document.getElementById("btn-menu"), menu = document.getElementById("menu");
  if (!btn || !menu) return;
  btn.addEventListener("click", function(){
    var aberto = menu.classList.toggle("aberto");
    btn.setAttribute("aria-expanded", aberto);
  });
  menu.querySelectorAll("a").forEach(function(a){ a.addEventListener("click", function(){ menu.classList.remove("aberto"); btn.setAttribute("aria-expanded", false); }); });
})();
(function(){
  document.addEventListener("click", function(e){
    var a = e.target.closest && e.target.closest('a[href*="#"]');
    if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey) return;
    var url = new URL(a.href, location.href);
    if (url.pathname !== location.pathname || !url.hash) return;
    var alvo = document.getElementById(decodeURIComponent(url.hash.slice(1)));
    if (!alvo) return;
    e.preventDefault();
    var saltar = function(){ alvo.scrollIntoView({block: "start", behavior: "instant"}); history.pushState(null, "", url.hash); };
    if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.startViewTransition(saltar); else saltar();
  });
})();
</script>

{%- unless template.name == 'index' or template.name == 'product' or template.name == 'password' or template.name == 'cart' or template.suffix == 'creme' or template.suffix == 'lista' -%}
<div class="fixa on fixa-geral"><a href="{{ cta_link }}" class="btn btn-verde btn-preco"{% if cta_link contains '/cart/' %} data-carrinho-add{% endif %}><span class="l1">{{ cta_txt }} <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>{%- if cta_v and cta_v.available -%}<span class="l2"><b>{{ cta_v.price | money_without_currency }}&nbsp;€</b> · {{ 'ondao.aviso.fixa_entrega' | t }}</span>{%- endif -%}</a></div>
{%- endunless -%}

{% schema %}
{"name": "Cabeçalho ondão", "settings": []}
{% endschema %}
