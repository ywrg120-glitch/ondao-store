<section class="secao pg" id="faq">
  <div class="wrap faq">
    <div class="cabeca">
      <h1 class="h2">{{ 'ondao.faq.titulo_html' | t }}</h1>
    </div>
    <details open><summary>{{ 'ondao.faq.unissexo_q' | t }}</summary><p>{{ 'ondao.faq.unissexo_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.tipo_q' | t }}</summary><p>{{ 'ondao.faq.tipo_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.ingredientes_q' | t }}</summary><p>{{ 'ondao.faq.ingredientes_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.duro_q' | t }}</summary><p>{{ 'ondao.faq.duro_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.preco_q' | t }}</summary><p>{{ 'ondao.faq.preco_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.animais_q' | t }}</summary><p>{{ 'ondao.faq.animais_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.fora_q' | t }}</summary><p>{{ 'ondao.faq.fora_a_html' | t }}</p></details>
    <details><summary>{{ 'ondao.faq.quando_q' | t }}</summary><p>{{ 'ondao.faq.quando_a_html' | t }}</p></details>
  </div>
</section>
{% render 'ondao-pg-cta' %}
<script>window.ONDAO_ASSET_BASE = {{ 'ondao-paginas.js' | asset_url | split: 'ondao-paginas.js' | first | json }};</script>
<script src="{{ 'ondao-paginas.js' | asset_url }}" defer></script>

{% schema %}
{"name": "FAQ ondão", "settings": [], "presets": [{"name": "FAQ ondão"}]}
{% endschema %}
