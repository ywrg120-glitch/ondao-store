<section class="secao pagina">
  <div class="wrap {% if template.name == 'cart' %}cx-wrap{% else %}estreito{% endif %}">
    {%- case template.name -%}
      {%- when 'page' -%}
        <h1 class="h2">{{ page.title }}</h1>
        <div class="texto">{{ page.content }}</div>
      {%- when 'cart' -%}
        {%- liquid
          assign gratis_cents = 3500
          assign falta = gratis_cents | minus: cart.total_price
          assign pct = cart.total_price | times: 100 | divided_by: gratis_cents
          if pct > 100
            assign pct = 100
          endif
        -%}
        <h1 class="h2">{{ 'ondao.cx.titulo' | t }}</h1>
        {%- if cart.item_count > 0 -%}
          <div class="cx">
            <div class="cx-itens">
              <div class="cx-portes" role="status">
                {%- if falta > 0 -%}
                  {%- capture falta_txt -%}{{ falta | money_without_currency }}&nbsp;€{%- endcapture -%}
                  <p>{{ 'ondao.cx.faltam_html' | t: valor: falta_txt }}</p>
                {%- else -%}
                  <p>{{ 'ondao.cx.tem_gratis_html' | t }}</p>
                {%- endif -%}
                <div class="cx-barra" aria-hidden="true"><span style="width:{{ pct }}%"></span></div>
              </div>
              <ul class="cx-lista">
                {%- for item in cart.items -%}
                <li class="cx-item">
                  <a class="cx-foto" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" width="100" height="100" alt="" loading="lazy">{%- endif -%}</a>
                  <div class="cx-info">
                    <a class="cx-nome" href="{{ item.url }}">{{ item.product.title }}</a>
                    <span class="cx-var">200 ml · {{ item.final_price | money_without_currency }}&nbsp;€ {{ 'ondao.cx.cada' | t }}</span>
                    <div class="cx-qtd">
                      <form action="{{ routes.cart_change_url }}" method="post"><input type="hidden" name="line" value="{{ forloop.index }}"><input type="hidden" name="quantity" value="{{ item.quantity | minus: 1 }}"><button type="submit" aria-label="{{ 'ondao.cx.tirar' | t }}"{% if item.quantity == 1 %} disabled{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg></button></form>
                      <span aria-label="{{ 'ondao.cx.qtd' | t }}">{{ item.quantity }}</span>
                      <form action="{{ routes.cart_change_url }}" method="post"><input type="hidden" name="line" value="{{ forloop.index }}"><input type="hidden" name="quantity" value="{{ item.quantity | plus: 1 }}"><button type="submit" aria-label="{{ 'ondao.cx.juntar_um' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></form>
                    </div>
                  </div>
                  <div class="cx-dir">
                    <b>{{ item.final_line_price | money_without_currency }}&nbsp;€</b>
                    <form action="{{ routes.cart_change_url }}" method="post"><input type="hidden" name="line" value="{{ forloop.index }}"><input type="hidden" name="quantity" value="0"><button class="cx-tirar" type="submit">{{ 'ondao.cx.remover' | t }}</button></form>
                  </div>
                </li>
                {%- endfor -%}
              </ul>
              {%- if falta > 0 and cart.items.size == 1 -%}
                {%- assign v1 = cart.items.first.variant -%}
                {%- if falta <= v1.price -%}
                <form class="cx-mais" action="{{ routes.cart_add_url }}" method="post">
                  <input type="hidden" name="id" value="{{ v1.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                  {%- capture v1p -%}{{ v1.price | money_without_currency }}&nbsp;€{%- endcapture -%}<p>{{ 'ondao.cx.mais_pagina_html' | t: preco: v1p }}</p>
                  <button class="btn btn-contorno" type="submit">{{ 'ondao.cx.juntar_1' | t }}</button>
                </form>
                {%- endif -%}
              {%- endif -%}
            </div>
            <aside class="cx-resumo" aria-label="{{ 'ondao.cx.resumo' | t }}">
              <dl>
                <div><dt>{{ 'ondao.cx.subtotal' | t }}</dt><dd>{{ cart.total_price | money_without_currency }}&nbsp;€</dd></div>
                <div><dt>{{ 'ondao.cx.portes' | t }}</dt><dd>{% if falta > 0 %}{{ 'ondao.cx.portes_pt' | t }}{% else %}{{ 'ondao.cx.gratis_pt' | t }}{% endif %}</dd></div>
              </dl>
              <p class="cx-nota">{{ 'ondao.cx.nota_pagina' | t }}{% assign tubos_cx = 0 %}{% for it in cart.items %}{% assign tubos_cx = tubos_cx | plus: it.quantity %}{% endfor %}{% if tubos_cx >= 2 %} {{ 'ondao.cx.inclui_escova' | t }}{% endif %}</p>
              <form action="{{ routes.cart_url }}" method="post"><button class="btn btn-verde btn-full" type="submit" name="checkout">{{ 'ondao.cx.finalizar' | t }}</button></form>
              <ul class="cx-conf">
                <li>{{ 'ondao.cx.dev_entrega' | t }}</li>
                <li>{{ 'ondao.cx.seguro' | t }}</li>
              </ul>
              {%- if shop.enabled_payment_types.size > 0 -%}<div class="cx-pag" aria-label="{{ 'ondao.geral.metodos' | t }}">{%- for tipo in shop.enabled_payment_types -%}{{ tipo | payment_type_svg_tag: class: 'cx-pag-i' }}{%- endfor -%}</div>{%- endif -%}
            </aside>
          </div>
        {%- else -%}
          <p class="cx-vazio">{{ 'ondao.cx.vazio' | t }}</p>
          <a class="btn btn-verde" href="{% render 'ondao-r' %}pages/creme">{{ 'ondao.geral.ver_creme' | t }}</a>
        {%- endif -%}
      {%- when '404' -%}
        <h1 class="h2">{{ 'ondao.p404.titulo' | t }}</h1>
        <p>{{ 'ondao.p404.txt' | t }}</p>
        <a class="btn btn-verde" href="{{ routes.root_url }}">{{ 'ondao.p404.voltar' | t }}</a>
      {%- when 'article' -%}
        <h1 class="h2">{{ article.title }}</h1>
        <div class="texto">{{ article.content }}</div>
      {%- when 'search' -%}
        <h1 class="h2">{{ 'ondao.pesquisa.titulo' | t }}</h1>
        <p>{{ 'ondao.pesquisa.um' | t }}</p>
        <a class="btn btn-verde" href="{% render 'ondao-r' %}pages/creme">{{ 'ondao.geral.ver_creme' | t }}</a>
      {%- else -%}
        <h1 class="h2">ondão</h1>
        <p>{{ 'ondao.pesquisa.um' | t }}</p>
        <a class="btn btn-verde" href="{% render 'ondao-r' %}pages/creme">{{ 'ondao.geral.ver_creme' | t }}</a>
    {%- endcase -%}
  </div>
</section>

{% schema %}
{"name": "Página simples", "settings": []}
{% endschema %}
