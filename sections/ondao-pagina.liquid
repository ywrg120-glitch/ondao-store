<section class="secao pagina">
  <div class="wrap {% if template.name == 'cart' %}cx-wrap{% else %}estreito{% endif %}">
    {%- case template.name -%}
      {%- when 'page' -%}
        <h1 class="h2">{{ page.title }}</h1>
        <div class="texto">{{ page.content }}</div>
      {%- when 'cart' -%}
        {%- liquid
          assign gratis_cents = 3500
          assign falta = gratis_cents | minus: cart.total_price
          assign pct = cart.total_price | times: 100 | divided_by: gratis_cents
          if pct > 100
            assign pct = 100
          endif
        -%}
        <h1 class="h2">O seu carrinho</h1>
        {%- if cart.item_count > 0 -%}
          <div class="cx">
            <div class="cx-itens">
              <div class="cx-portes" role="status">
                {%- if falta > 0 -%}
                  <p>Faltam <b>{{ falta | money_without_currency }}&nbsp;€</b> para ter <b>portes grátis</b> em Portugal.</p>
                {%- else -%}
                  <p><b>Tem portes grátis</b> em Portugal.</p>
                {%- endif -%}
                <div class="cx-barra" aria-hidden="true"><span style="width:{{ pct }}%"></span></div>
              </div>
              <ul class="cx-lista">
                {%- for item in cart.items -%}
                <li class="cx-item">
                  <a class="cx-foto" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" width="100" height="100" alt="" loading="lazy">{%- endif -%}</a>
                  <div class="cx-info">
                    <a class="cx-nome" href="{{ item.url }}">{{ item.product.title }}</a>
                    <span class="cx-var">200 ml · {{ item.final_price | money_without_currency }}&nbsp;€ cada</span>
                    <div class="cx-qtd">
                      <form action="{{ routes.cart_change_url }}" method="post"><input type="hidden" name="line" value="{{ forloop.index }}"><input type="hidden" name="quantity" value="{{ item.quantity | minus: 1 }}"><button type="submit" aria-label="Tirar um tubo"{% if item.quantity == 1 %} disabled{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg></button></form>
                      <span aria-label="Quantidade">{{ item.quantity }}</span>
                      <form action="{{ routes.cart_change_url }}" method="post"><input type="hidden" name="line" value="{{ forloop.index }}"><input type="hidden" name="quantity" value="{{ item.quantity | plus: 1 }}"><button type="submit" aria-label="Juntar um tubo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></form>
                    </div>
                  </div>
                  <div class="cx-dir">
                    <b>{{ item.final_line_price | money_without_currency }}&nbsp;€</b>
                    <form action="{{ routes.cart_change_url }}" method="post"><input type="hidden" name="line" value="{{ forloop.index }}"><input type="hidden" name="quantity" value="0"><button class="cx-tirar" type="submit">Remover</button></form>
                  </div>
                </li>
                {%- endfor -%}
              </ul>
              {%- if falta > 0 and cart.items.size == 1 -%}
                {%- assign v1 = cart.items.first.variant -%}
                {%- if falta <= v1.price -%}
                <form class="cx-mais" action="{{ routes.cart_add_url }}" method="post">
                  <input type="hidden" name="id" value="{{ v1.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                  <p><b>Junte mais um tubo</b> por {{ v1.price | money_without_currency }}&nbsp;€ e os portes ficam grátis.</p>
                  <button class="btn btn-contorno" type="submit">Juntar 1 tubo</button>
                </form>
                {%- endif -%}
              {%- endif -%}
            </div>
            <aside class="cx-resumo" aria-label="Resumo">
              <dl>
                <div><dt>Subtotal</dt><dd>{{ cart.total_price | money_without_currency }}&nbsp;€</dd></div>
                <div><dt>Portes</dt><dd>{% if falta > 0 %}4,50&nbsp;€ em Portugal{% else %}Grátis em Portugal{% endif %}</dd></div>
              </dl>
              <p class="cx-nota">Valor final dos portes e impostos no checkout. Encomendas até às 17:00 de um dia útil saem no mesmo dia e chegam no dia útil seguinte.{% assign tubos_cx = 0 %}{% for it in cart.items %}{% assign tubos_cx = tubos_cx | plus: it.quantity %}{% endfor %}{% if tubos_cx >= 2 %} Inclui a escova de caracóis de oferta.{% endif %}</p>
              <form action="{{ routes.cart_url }}" method="post"><button class="btn btn-verde btn-full" type="submit" name="checkout">Finalizar compra</button></form>
              <ul class="cx-conf">
                <li>14 dias para devolver, a contar da entrega</li>
                <li>Pagamento seguro</li>
              </ul>
              {%- if shop.enabled_payment_types.size > 0 -%}<div class="cx-pag" aria-label="Métodos de pagamento aceites">{%- for tipo in shop.enabled_payment_types -%}{{ tipo | payment_type_svg_tag: class: 'cx-pag-i' }}{%- endfor -%}</div>{%- endif -%}
            </aside>
          </div>
        {%- else -%}
          <p class="cx-vazio">O seu carrinho está vazio.</p>
          <a class="btn btn-verde" href="/pages/creme">Ver o creme</a>
        {%- endif -%}
      {%- when '404' -%}
        <h1 class="h2">Página não encontrada</h1>
        <p>Esta página não existe ou mudou de sítio.</p>
        <a class="btn btn-verde" href="{{ routes.root_url }}">Voltar à loja</a>
      {%- when 'article' -%}
        <h1 class="h2">{{ article.title }}</h1>
        <div class="texto">{{ article.content }}</div>
      {%- when 'search' -%}
        <h1 class="h2">Pesquisa</h1>
        <p>Por agora temos um só produto: o Creme Finalizador para Pentear.</p>
        <a class="btn btn-verde" href="/pages/creme">Ver o creme</a>
      {%- else -%}
        <h1 class="h2">ondão</h1>
        <p>Por agora temos um só produto: o Creme Finalizador para Pentear.</p>
        <a class="btn btn-verde" href="/pages/creme">Ver o creme</a>
    {%- endcase -%}
  </div>
</section>

{% schema %}
{"name": "Página simples", "settings": []}
{% endschema %}
