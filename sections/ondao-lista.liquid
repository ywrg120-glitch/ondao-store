<section class="vip tex vip-pagina" id="vip">
  <div class="wrap">
    <div>
      <h1 class="h2">{{ 'ondao.lista.titulo_html' | t }}</h1>
      <p class="lead" style="margin-top:16px">{{ 'ondao.lista.lead1' | t }}</p>
      <p class="lead" style="margin-top:10px">{{ 'ondao.lista.lead2' | t }}</p>
      <figure class="news-foto"><img src="{{ 'ondao-09-newsletter.jpg' | asset_img_url: '810x' }}" width="1080" height="1350" alt="{{ 'ondao.lista.alt' | t }}" loading="lazy"></figure>
    </div>
    <form id="form-vip" novalidate>
      <div class="campo">
        <label for="email">{{ 'ondao.lista.email' | t }}</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="nome@email.com">
      </div>
      <div class="campo">
        <label for="nome">{{ 'ondao.lista.nome' | t }}</label>
        <input id="nome" name="nome" autocomplete="given-name" placeholder="{{ 'ondao.lista.nome_ph' | t }}">
      </div>
      <div class="campo">
        <span class="rotulo" id="rotulo-cabelo">{{ 'ondao.lista.cabelo' | t }}</span>
        <div class="tipos-f" role="radiogroup" aria-labelledby="rotulo-cabelo">
          <label><input type="radio" name="cabelo" value="ondas">{{ 'ondao.tipos.ondas' | t }}</label>
          <label><input type="radio" name="cabelo" value="caracois">{{ 'ondao.tipos.caracois' | t }}</label>
          <label><input type="radio" name="cabelo" value="caracois-fechados">{{ 'ondao.tipos.fechados' | t }}</label>
          <label><input type="radio" name="cabelo" value="nao-sei">{{ 'ondao.tipos.nao_sei' | t }}</label>
        </div>
      </div>
      <input type="hidden" name="plano" id="plano" value="unica">
      <input type="hidden" name="origem" id="origem" value="">
      <input type="hidden" name="_subject" value="Nova inscrição na newsletter ondão">
      <label class="consent"><input type="checkbox" name="consent" value="accepted" required> <span>{{ 'ondao.news.consent' | t }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'ondao.lista.privacidade' | t }}</a>.</span></label>
      <button class="btn btn-terra btn-full" type="submit">{{ 'ondao.lista.quero' | t }}</button>
      <p class="msg" id="msg" role="status"></p>
    </form>
  </div>
</section>

<section class="secao pagina-fim">
  <div class="wrap" style="text-align:center">
    <a class="btn btn-contorno" href="{% render 'ondao-r' %}pages/creme">{{ 'ondao.geral.ver_creme' | t }}</a>
  </div>
</section>

<script>
window.ONDAO_NEWS = {erro_email: {{ 'ondao.news.erro_email' | t | json }}, erro_consent: {{ 'ondao.news.erro_consent' | t | json }}, a_inscrever: {{ 'ondao.news.a_inscrever' | t | json }}, ok: {{ 'ondao.news.ok_longo' | t | json }}, falhou: {{ 'ondao.news.falhou' | t | json }}};
(function(){
  var N = window.ONDAO_NEWS;
  var ENDPOINT = "https://formspree.io/f/xqpegzwz";
  function contar(n){ try { window.goatcounter && window.goatcounter.count && window.goatcounter.count({path:n,title:n,event:true}); } catch(e){} }
  var qs = new URLSearchParams(location.search);
  var form = document.getElementById("form-vip"), msg = document.getElementById("msg");
  document.getElementById("origem").value = qs.get("utm_source") || document.referrer || "direto";
  var tipo = qs.get("cabelo");
  var antigos = {ondulado:"ondas", cacheado:"caracois", crespo:"caracois-fechados"};
  if (tipo && antigos[tipo]) tipo = antigos[tipo];
  if (tipo) { var r = form.querySelector('input[name="cabelo"][value="' + tipo.replace(/[^a-z-]/g,"") + '"]'); if (r) r.checked = true; }
  form.addEventListener("submit", async function(e){
    e.preventDefault();
    var email = form.email.value.trim();
    if (!/^\S+@\S+\.\S+$/.test(email)) { msg.textContent = N.erro_email; return; }
    if (!form.consent.checked) { msg.textContent = N.erro_consent; return; }
    msg.textContent = N.a_inscrever;
    try {
      var r = await fetch(ENDPOINT, {method:"POST", body:new FormData(form), headers:{Accept:"application/json"}});
      if (!r.ok) throw 0;
      form.reset();
      msg.textContent = N.ok;
      try { localStorage.setItem("ondao_vip","1"); } catch(e){}
      contar("inscricao-formulario");
    } catch(err) { msg.textContent = N.falhou; }
  });
})();
</script>

{% schema %}
{"name": "Newsletter ondão", "settings": []}
{% endschema %}
