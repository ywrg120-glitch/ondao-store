<section class="pagina-pw">
  <div class="wrap estreito">
    <span class="logo">ondão</span>
    <h1 class="h2">{{ 'ondao.historia.titulo_html' | t }}</h1>
    <p>{{ 'ondao.pw.breve' | t }}</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <label for="pw" class="sr">{{ 'ondao.pw.pw' | t }}</label>
      <input type="password" name="password" id="pw" placeholder="{{ 'ondao.pw.pw_loja' | t }}" autocomplete="current-password">
      <button class="btn btn-verde" type="submit">{{ 'ondao.pw.entrar' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{"name": "Palavra-passe", "settings": []}
{% endschema %}
