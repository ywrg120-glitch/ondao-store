      <a class="lj-btn lj-btn-claro" href="{{ link }}" data-lj-cta>{{ txt_cta }}</a>
      {%- if a_venda -%}<p class="lj-hero-preco">{{ preco }} · envio em até {{ dias }} dias</p>{%- endif -%}
    </div>
  </section>

  <!-- FAIXA -->
