{%- comment -%}
  Loja de um só produto. Estrutura inspirada na página de produto da Wavy
  (hero com modelo → faixa → produto → benefícios → cartões → citação em verde →
  FAQ → banner com foto → retratos → newsletter), com cores, imagens e textos ondão.
{%- endcomment -%}
{%- liquid
  if product
    assign p = product
  elsif section.settings.produto != blank
    assign p = section.settings.produto
  else
    assign p = all_products['creme-finalizador-para-pentear-com-oleo-de-cacay']
  endif
  assign a_venda = false
  assign link = routes.root_url | append: '/pages/lista' | replace: '//', '/'
  if p != blank
    assign v = p.selected_or_first_available_variant
    if v.available
      assign a_venda = true
      assign link = '/cart/' | append: v.id | append: ':1'
    endif
  endif
  assign dias = section.settings.dias_preparacao
  assign dev = section.settings.dias_devolucao
  assign portes_txt = section.settings.portes_pt | default: '4,50'
  assign gratis = section.settings.portes_gratis | default: 35
  assign gratis_cents = gratis | times: 100
  assign e_produto = false
  if template.name == 'product'
    assign e_produto = true
  endif
-%}
{{ 'ondao-loja.css' | asset_url | stylesheet_tag }}

{%- capture seta -%}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture preco -%}{% if v %}{{ v.price | money_without_currency }} €{% else %}19,99 €{% endif %}{%- endcapture -%}
{%- capture preco2 -%}{% if v %}{{ v.price | times: 2 | money_without_currency }} €{% else %}39,98 €{% endif %}{%- endcapture -%}
{%- liquid
  assign dois_gratis = true
  if v
    assign dobro = v.price | times: 2
    if dobro < gratis_cents
      assign dois_gratis = false
    endif
  endif
-%}
{%- if a_venda -%}{%- assign txt_cta = 'ondao.geral.adicionar' | t -%}{%- else -%}{%- assign txt_cta = 'ondao.loja.vip_entrar' | t -%}{%- endif -%}

<div class="lj">

  <!-- HERO -->
  <section class="lj-hero">
    <picture>
      <source media="(min-width: 900px), (orientation: landscape) and (min-width: 600px)" srcset="{{ 'ondao-01-topo-computador.jpg' | asset_url }}" width="1920" height="1080">
      <img class="lj-hero-foto" src="{{ 'ondao-01-topo-telemovel.jpg' | asset_url }}" width="1080" height="1350" alt="{{ 'ondao.loja.alt.hero' | t }}" fetchpriority="high">
    </picture>
    {%- if settings.ondao_video_topo -%}
    <video class="lj-hero-foto lj-video" id="lj-video-topo" muted loop playsinline preload="none" aria-hidden="true"
      data-telemovel="{{ 'ondao-01-topo-telemovel.mp4' | asset_url }}" data-computador="{{ 'ondao-01-topo-computador.mp4' | asset_url }}"></video>
    {%- endif -%}
    <div class="lj-hero-txt">
      {%- if e_produto -%}<p class="lj-h1">{%- else -%}<h1 class="lj-h1">{%- endif -%}{{ 'ondao.loja.hero_html' | t }}{%- if e_produto -%}</p>{%- else -%}</h1>{%- endif %}
      <p>{{ 'ondao.loja.hero_sub' | t }}</p>
      <a class="lj-btn lj-btn-claro" href="{{ link }}" data-lj-cta{% if a_venda %} data-carrinho-add{% endif %}>{{ txt_cta }}</a>
      {%- if a_venda -%}<p class="lj-hero-preco">{{ preco }} · <span data-prazo-hero>{{ 'ondao.loja.hero_prazo' | t }}</span></p>{%- endif -%}
    </div>
  </section>

  <!-- FAIXA -->
  <div class="lj-faixa"><p>{{ 'ondao.loja.faixa_html' | t }}</p></div>

  <!-- PRODUTO -->
