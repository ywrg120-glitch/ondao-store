          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-2.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-2.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-2.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-2.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="Tubo ondão numa prateleira com pente de madeira e toalha de linho" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-3.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-3.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-3.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-3.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="Textura do creme ondão" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-4.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-4.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-4.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-4.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="Tubo ondão com os ingredientes da fórmula" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-5.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-5.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-5.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-5.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="O creme ondão a ser aplicado" loading="lazy"></div>
