    <div class="lj-wrap lj-prod-grid">
      <div class="lj-galeria">
        <div class="lj-slides" id="lj-slides" tabindex="0" aria-label="{{ 'ondao.loja.fotos' | t }}">
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-1.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-1.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-1.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-1.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.g1' | t }}"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-2.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-2.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-2.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-2.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.g2' | t }}" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-3.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-3.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-3.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-3.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.g3' | t }}" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-4.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-4.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-4.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-4.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.g4' | t }}" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-5.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-5.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-5.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-5.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.g5' | t }}" loading="lazy"></div>
          <div class="lj-slide"><img src="{{ 'ondao-02-galeria-6.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-02-galeria-6.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-02-galeria-6.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-02-galeria-6.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 580px, 100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.g6' | t }}" loading="lazy"></div>
          {%- if settings.ondao_video_galeria -%}
          <div class="lj-slide"><video class="lj-video" src="{{ 'ondao-02-galeria-video.mp4' | asset_url }}" muted loop playsinline preload="none" poster="{{ 'ondao-02-galeria-video.jpg' | asset_url }}" aria-label="{{ 'ondao.loja.alt.gvideo' | t }}"></video></div>
          {%- endif -%}
        </div>
        <div class="lj-pontos" id="lj-pontos"></div>
      </div>

      <div class="lj-info">
        {%- if e_produto -%}<h1 class="lj-titulo">{%- else -%}<h2 class="lj-titulo">{%- endif -%}{{ 'ondao.geral.produto' | t }}{%- if e_produto -%}</h1>{%- else -%}</h2>{%- endif %}
        <p class="lj-preco"><b>{{ preco }}</b><span>200 ml · {% if v %}{{ v.price | times: 0.5 | money_without_currency }} €{% else %}10,00 €{% endif %}/100 ml</span></p>
        {%- if a_venda -%}
        <div class="lj-prazo" data-pais="{{ localization.country.iso_code | default: 'PT' }}" data-modo="encomenda" data-corte="17" data-dias="{{ dias }}">
          <p class="lj-prazo-topo"><span data-t1>{{ 'ondao.ljjs.t1_proximas' | t }}</span> <b data-prazo-conta>—</b> <span data-t2>{{ 'ondao.ljjs.t2_receba' | t }}</span> <b data-prazo-entrega-curta>—</b></p>
          <ol class="lj-linha">
            <li class="feito"><span>{{ 'ondao.loja.prazo_encomenda' | t }}</span><b>{{ 'ondao.loja.prazo_hoje' | t }}</b></li>
            <li><span>{{ 'ondao.loja.prazo_envio' | t }}</span><b data-prazo-envio>—</b></li>
            <li><span>{{ 'ondao.loja.prazo_entrega' | t }}</span><b data-prazo-entrega>—</b></li>
          </ol>
        </div>
        {%- else -%}<p class="lj-estado">{{ 'ondao.loja.pre_lancamento' | t }}</p>{%- endif -%}
        <p class="lj-desc">{{ 'ondao.loja.desc' | t }}</p>

        <ul class="lj-vantagens">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14z"/><path d="M5 19l7-7"/></svg>{{ 'ondao.loja.v1' | t }}</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12c3-4 6-4 9 0s6 4 9 0"/></svg>{{ 'ondao.loja.v2' | t }}</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>{{ 'ondao.loja.v3' | t }}</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3.5 4.2 5.5 7.4 5.5 10.2a5.5 5.5 0 0 1-11 0C6.5 10.4 8.5 7.2 12 3z"/></svg>{{ 'ondao.loja.v4' | t }}</li>
        </ul>

        {%- if a_venda -%}
        <fieldset class="lj-qtd">
          <legend>{{ 'ondao.cx.qtd' | t }}</legend>
          <label class="lj-opcao">
            <input type="radio" name="lj-qtd" value="1" checked>
            <span class="lj-opcao-txt"><b>{{ 'ondao.loja.um_tubo' | t }}</b><span>{{ 'ondao.loja.portes_pt' | t: v: portes_txt }}</span></span>
            <span class="lj-opcao-preco"><b>{{ preco }}</b></span>
          </label>
          <label class="lj-opcao">
            <input type="radio" name="lj-qtd" value="2">
            <span class="lj-opcao-txt"><b>{{ 'ondao.loja.dois_tubos' | t }}</b><span>{% if dois_gratis %}{{ 'ondao.loja.portes_gratis' | t }}{% else %}{{ 'ondao.loja.por_tubo' | t: preco: preco }}{% endif %}</span><span class="lj-bf"><button type="button" class="lj-bf-ver" data-escova aria-label="{{ 'ondao.loja.escova_ver' | t }}"><img src="{{ 'ondao-escova.jpg' | asset_img_url: '160x160', crop: 'center' }}" width="56" height="56" alt="" loading="lazy"><i aria-hidden="true">+</i></button><span>{{ 'ondao.loja.escova_oferta' | t }}<small>{{ 'ondao.loja.escova_toque' | t }}</small></span></span></span>
            <span class="lj-opcao-preco"><b>{{ preco2 }}</b></span>
            <em class="lj-tag">{{ 'ondao.loja.escova_tag' | t }}</em>
          </label>
        </fieldset>
        {%- else -%}
        <div class="lj-opcao lj-opcao-vip"><span class="lj-opcao-txt"><b>Lista VIP</b><span>{{ 'ondao.loja.vip_txt' | t }}</span></span><span class="lj-opcao-preco"><b>{{ preco }}</b></span></div>
        {%- endif -%}

        <a class="lj-btn lj-btn-escuro lj-btn-full" id="lj-comprar" href="{{ link }}" data-lj-cta{% if a_venda %} data-carrinho-add{% endif %}>{{ txt_cta }}</a>
        {%- if a_venda -%}
        <div class="lj-express">
          <p class="lj-ou"><span>{{ 'ondao.loja.ou_toque' | t }}</span></p>
          {%- form 'product', p -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <input type="hidden" name="quantity" value="1" id="lj-qtd-express">
            {{ form | payment_button }}
          {%- endform -%}
        </div>
        <ul class="lj-confianca">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg><span>{{ 'ondao.loja.conf_portes_html' | t: v: portes_txt, g: gratis }}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/></svg><span>{{ 'ondao.loja.conf_dev' | t: d: dev }}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>{{ 'ondao.loja.conf_seguro' | t }}</span></li>
        </ul>
        {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="lj-pagamentos" aria-label="{{ 'ondao.geral.metodos' | t }}">
          {%- for tipo in shop.enabled_payment_types -%}{{ tipo | payment_type_svg_tag: class: 'lj-pag' }}{%- endfor -%}
        </div>
        {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- ORIGEM + MAPA DE INGREDIENTES -->
  <section class="lj-origem">
    <div class="lj-origem-foto">
      <picture>
        <source media="(min-width: 900px)" srcset="{{ 'ondao-06-banner-computador.jpg' | asset_url }}">
        <img src="{{ 'ondao-06-banner-telemovel.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-06-banner-telemovel.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-06-banner-telemovel.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-06-banner-telemovel.jpg' | asset_img_url: '1080x' }} 1080w" sizes="100vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.origem' | t }}" loading="lazy">
      </picture>
      <span class="lj-origem-selo">{{ 'ondao.loja.selo' | t }}</span>
    </div>
    <div class="lj-origem-txt">
            <h2 class="lj-h2">{{ 'ondao.loja.ativos_html' | t }}</h2>
