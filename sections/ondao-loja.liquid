          <div class="lj-ing-corpo"><em>{{ 'ondao.ing.cacay.latim' | t }}</em><p>{{ 'ondao.ing.cacay.corpo' | t }}</p><p><strong>{{ 'ondao.ing.na_formula' | t }}:</strong> {{ 'ondao.loja.ing_cacay_funcao' | t }}</p></div></details></li>
        <li><details class="lj-ing"><summary><img src="{{ 'ing-sacha-inchi-still.jpg' | asset_img_url: '160x160', crop: 'center' }}" width="64" height="64" alt="" loading="lazy"><div><b>{{ 'ondao.loja.ing_sacha_inchi_nome' | t }}</b><span>{{ 'ondao.ing.sacha_inchi.curto' | t }}</span></div><i class="lj-ing-mais" aria-hidden="true"></i></summary>
          <div class="lj-ing-corpo"><em>{{ 'ondao.ing.sacha_inchi.latim' | t }}</em><p>{{ 'ondao.ing.sacha_inchi.corpo' | t }}</p><p><strong>{{ 'ondao.ing.na_formula' | t }}:</strong> {{ 'ondao.ing.sacha_inchi.funcao' | t }}</p></div></details></li>
        <li><details class="lj-ing"><summary><img src="{{ 'ing-ungurahui-still.jpg' | asset_img_url: '160x160', crop: 'center' }}" width="64" height="64" alt="" loading="lazy"><div><b>{{ 'ondao.loja.ing_ungurahui_nome' | t }}</b><span>{{ 'ondao.loja.ing_ungurahui_curto' | t }}</span></div><i class="lj-ing-mais" aria-hidden="true"></i></summary>
          <div class="lj-ing-corpo"><em>{{ 'ondao.ing.ungurahui.latim' | t }}</em><p>{{ 'ondao.ing.ungurahui.corpo' | t }}</p><p><strong>{{ 'ondao.ing.na_formula' | t }}:</strong> {{ 'ondao.ing.ungurahui.funcao' | t }}</p></div></details></li>
        <li><details class="lj-ing"><summary><img src="{{ 'ing-quinoa-still.jpg' | asset_img_url: '160x160', crop: 'center' }}" width="64" height="64" alt="" loading="lazy"><div><b>{{ 'ondao.loja.ing_quinoa_nome' | t }}</b><span>{{ 'ondao.ing.quinoa.curto' | t }}</span></div><i class="lj-ing-mais" aria-hidden="true"></i></summary>
          <div class="lj-ing-corpo"><em>{{ 'ondao.ing.quinoa.latim' | t }}</em><p>{{ 'ondao.ing.quinoa.corpo' | t }}</p><p><strong>{{ 'ondao.ing.na_formula' | t }}:</strong> {{ 'ondao.ing.quinoa.funcao' | t }}</p></div></details></li>
        <li><details class="lj-ing"><summary><img src="{{ 'ing-poliglutamico-still.jpg' | asset_img_url: '160x160', crop: 'center' }}" width="64" height="64" alt="" loading="lazy"><div><b>{{ 'ondao.loja.ing_poliglutamico_nome' | t }}</b><span>{{ 'ondao.ing.poliglutamico.curto' | t }}</span></div><i class="lj-ing-mais" aria-hidden="true"></i></summary>
          <div class="lj-ing-corpo"><em>{{ 'ondao.ing.poliglutamico.latim' | t }}</em><p>{{ 'ondao.ing.poliglutamico.corpo' | t }}</p><p><strong>{{ 'ondao.ing.na_formula' | t }}:</strong> {{ 'ondao.ing.poliglutamico.funcao' | t }}</p></div></details></li>
      </ul>
      <p class="lj-inci">{{ 'ondao.loja.inci' | t }} <a href="{% render 'ondao-r' %}pages/ingredientes">{{ 'ondao.nav.ingredientes' | t }}</a>.</p>
    </div>
  </section>

  <!-- PARA ELA E PARA ELE -->
  <section class="lj-secao">
    <h2 class="lj-h2 lj-centro">{{ 'ondao.loja.cartoes_tit' | t }}</h2>
    <div class="lj-rolo">
      <article class="lj-cartao">
        {%- if false -%}<video class="lj-video" src="{{ 'ondao-03-cartao-1.mp4' | asset_url }}" poster="{{ 'ondao-03-cartao-1.jpg' | asset_img_url: '810x' }}" muted loop playsinline preload="none" width="1080" height="1350" aria-label="Homem com cabelo ondulado definido num dia húmido"></video>{%- else -%}<img src="{{ 'ondao-03-cartao-1.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-03-cartao-1.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-03-cartao-1.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-03-cartao-1.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 536px, 78vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.c1' | t }}" loading="lazy">{%- endif -%}
        <h3>{{ 'ondao.loja.v1' | t }}</h3>
        <p>{{ 'ondao.loja.c1_txt' | t }}</p>
      </article>
      <article class="lj-cartao">
        {%- if false -%}<video class="lj-video" src="{{ 'ondao-03-cartao-2.mp4' | asset_url }}" poster="{{ 'ondao-03-cartao-2.jpg' | asset_img_url: '810x' }}" muted loop playsinline preload="none" width="1080" height="1350" aria-label="Mulher a amachucar os caracóis com as mãos"></video>{%- else -%}<img src="{{ 'ondao-03-cartao-2.jpg' | asset_img_url: '1080x' }}" srcset="{{ 'ondao-03-cartao-2.jpg' | asset_img_url: '540x' }} 540w, {{ 'ondao-03-cartao-2.jpg' | asset_img_url: '810x' }} 810w, {{ 'ondao-03-cartao-2.jpg' | asset_img_url: '1080x' }} 1080w" sizes="(min-width: 900px) 536px, 78vw" width="1080" height="1350" alt="{{ 'ondao.loja.alt.c2' | t }}" loading="lazy">{%- endif -%}
        <h3>{{ 'ondao.loja.c2_tit' | t }}</h3>
        <p>{{ 'ondao.loja.c2_txt' | t }}</p>
      </article>
    </div>
  </section>

  {%- if settings.ondao_video_como_usar -%}
  <!-- COMO USAR -->
  <section class="lj-secao lj-como">
    <div class="lj-wrap lj-como-grid">
      <div class="lj-como-video"><video class="lj-video" src="{{ 'ondao-04-como-usar.mp4' | asset_url }}" poster="{{ 'ondao-04-como-usar.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="{{ 'ondao.loja.video_como' | t }}"></video></div>
      <div>
        <h2 class="lj-h2">{{ 'ondao.loja.modo' | t }}</h2>
        <ol class="lj-passos">
          <li><img src="{{ 'ondao-04-passo-1.jpg' | asset_img_url: '240x' }}" width="72" height="90" alt="" loading="lazy"><b>{{ 'ondao.loja.p1t' | t }}</b><span>{{ 'ondao.loja.p1' | t }}</span></li>
          <li><img src="{{ 'ondao-04-passo-2.jpg' | asset_img_url: '240x' }}" width="72" height="90" alt="" loading="lazy"><b>{{ 'ondao.loja.p2t' | t }}</b><span>{{ 'ondao.loja.p2' | t }}</span></li>
          <li><img src="{{ 'ondao-04-passo-3.jpg' | asset_img_url: '240x' }}" width="72" height="90" alt="" loading="lazy"><b>{{ 'ondao.loja.p3t' | t }}</b><span>{{ 'ondao.loja.p3' | t }}</span></li>
        </ol>
        <a class="lj-btn lj-btn-escuro" href="{{ link }}" data-lj-cta{% if a_venda %} data-carrinho-add{% endif %}>{{ txt_cta }}</a>
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- CITAÇÃO DO FUNDADOR -->
  <section class="lj-verde">
    {%- if settings.ondao_foto_fundador -%}<img class="lj-fundador" src="{{ 'ondao-05-fundador.jpg' | asset_img_url: '300x' }}" alt="{{ 'ondao.geral.fundador_alt' | t }}" loading="lazy" width="640" height="640">{%- endif -%}
        <blockquote>{{ 'ondao.loja.citacao' | t }}</blockquote>
    <cite>{{ 'ondao.loja.cite' | t }}</cite>
    <a class="lj-btn lj-btn-escuro" href="{% render 'ondao-r' %}pages/historia">{{ 'ondao.loja.ler_historia' | t }}</a>
  </section>

  <!-- FAQ -->
  <section class="lj-secao lj-faq">
    <div class="lj-wrap-estreito">
      <h2 class="lj-h2">{{ 'ondao.nav.perguntas' | t }}</h2>
      <details open><summary>{{ 'ondao.faq.unissexo_q' | t }}</summary><p>{{ 'ondao.faq.unissexo_a_html' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_funciona_q' | t }}</summary><p>{{ 'ondao.loja.faq_funciona_a' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_caro_q' | t }}</summary><p>{{ 'ondao.loja.faq_caro_a' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_diferente_q' | t }}</summary><p>{{ 'ondao.loja.faq_diferente_a' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_comeco_q' | t }}</summary><p>{{ 'ondao.loja.faq_comeco_a' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_dia2_q' | t }}</summary><p>{{ 'ondao.loja.faq_dia2_a' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_duro2_q' | t }}</summary><p>{{ 'ondao.loja.faq_duro2_a' | t }}</p></details>
      <details><summary>{{ 'ondao.loja.faq_ing2_q' | t }}</summary><p>{{ 'ondao.loja.faq_ing2_a' | t }}</p></details>
      <details><summary>{{ 'ondao.faq.quando_q' | t }}</summary><p>{{ 'ondao.faq.quando_a_html' | t }}</p></details>
      <a class="lj-link" href="{% render 'ondao-r' %}pages/faq">{{ 'ondao.loja.todas' | t }} {{ seta }}</a>
    </div>
  </section>


  <!-- RETRATOS -->
  <section class="lj-secao lj-retratos-sec">
    <h2 class="lj-h2 lj-centro">{{ 'ondao.loja.retratos_tit' | t }}</h2>
    <p class="lj-centro lj-sub">{{ 'ondao.loja.retratos_sub' | t }}</p>
    <div class="lj-retratos">
      {%- assign nomes = 'ondao.loja.retratos_nomes' | t | split: '|' -%}
      {%- assign doses = 'ondao.loja.retratos_doses' | t | split: '|' -%}
      {%- assign altos = 'ondao.loja.retratos_alts' | t | split: '|' -%}
      {%- for i in (1..3) -%}
      {%- capture f -%}ondao-07-retrato-{{ i }}.jpg{%- endcapture -%}
      {%- assign k = forloop.index0 -%}
      <figure class="lj-retrato">
        <img src="{{ f | asset_img_url: '810x' }}" srcset="{{ f | asset_img_url: '360x' }} 360w, {{ f | asset_img_url: '540x' }} 540w, {{ f | asset_img_url: '810x' }} 810w" sizes="(min-width: 900px) 240px, 31vw" width="1080" height="1440" alt="{{ altos[k] }}" loading="lazy">
        <figcaption><b>{{ nomes[k] }}</b><span>{{ doses[k] }}</span></figcaption>
      </figure>
      {%- endfor -%}
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="lj-news">
    <form class="lj-wrap-estreito" id="lj-news" novalidate>
      <p>{{ 'ondao.loja.news_txt' | t }}</p>
      <label for="lj-email">{{ 'ondao.loja.email' | t }}</label>
      <input id="lj-email" name="email" type="email" autocomplete="email" required>
      <input type="hidden" name="origem" value="newsletter-rodape">
      <input type="hidden" name="_subject" value="Nova inscrição na newsletter ondão">
      <label class="lj-consent"><input type="checkbox" name="consent" value="accepted" required> <span>{{ 'ondao.news.consent' | t }}</span></label>
      <button class="lj-btn lj-btn-contorno" type="submit">{{ 'ondao.loja.inscrever' | t }}</button>
      <p class="lj-msg" id="lj-msg" role="status"></p>
    </form>
  </section>


  <dialog class="lj-escova-dlg" id="lj-escova-dlg" aria-label="{{ 'ondao.cxjs.escova' | t }}">
    <img src="{{ 'ondao-escova-grande.jpg' | asset_url }}" width="1200" height="1200" alt="{{ 'ondao.loja.alt.escova' | t }}" loading="lazy">
    <p>{{ 'ondao.loja.escova_dlg' | t }}</p>
    <form method="dialog"><button class="lj-escova-fechar" aria-label="{{ 'ondao.geral.fechar' | t }}">×</button></form>
  </dialog>

  <!-- BOTÃO FIXO -->
  <div class="lj-fixa" id="lj-fixa"><a class="lj-btn lj-btn-escuro" href="{{ link }}" data-lj-cta{% if a_venda %} data-carrinho-add{% endif %}>{{ txt_cta }}{% if a_venda %} · <span data-lj-total>{{ preco }}</span>{% else %} {{ seta }}{% endif %}</a></div>
</div>

<script>window.ONDAO_LJ = {"dias": {{ 'ondao.ljjs.dias' | t | json }},"hoje": {{ 'ondao.ljjs.hoje' | t | json }},"amanha": {{ 'ondao.ljjs.amanha' | t | json }},"as_": {{ 'ondao.ljjs.as_' | t | json }},"t1_ate": {{ 'ondao.ljjs.t1_ate' | t | json }},"t2_envio": {{ 'ondao.ljjs.t2_envio' | t | json }},"hero_receba": {{ 'ondao.ljjs.hero_receba' | t | json }},"hero_envio": {{ 'ondao.ljjs.hero_envio' | t | json }},"ate": {{ 'ondao.ljjs.ate' | t | json }},"entrega_ate": {{ 'ondao.ljjs.entrega_ate' | t | json }},"checkout": {{ 'ondao.ljjs.checkout' | t | json }},"foto": {{ 'ondao.ljjs.foto' | t | json }},"t1_proximas": {{ 'ondao.ljjs.t1_proximas' | t | json }},"t2_receba": {{ 'ondao.ljjs.t2_receba' | t | json }}, "news_email": {{ 'ondao.news.erro_email' | t | json }}, "news_consent": {{ 'ondao.news.erro_consent' | t | json }}, "news_ok": {{ 'ondao.news.ok' | t | json }}, "news_falhou": {{ 'ondao.news.falhou' | t | json }}};</script>
<script>
(function(){
  // galeria
  var s = document.getElementById("lj-slides"), pts = document.getElementById("lj-pontos");
  if (s && pts) {
    [].forEach.call(s.children, function(sl, i){
      var b = document.createElement("button"); b.type = "button"; b.setAttribute("aria-label", window.ONDAO_LJ.foto.replace("{i}", i + 1).replace("{n}", s.children.length));
      b.addEventListener("click", function(){ s.scrollTo({left: sl.offsetLeft, behavior: "smooth"}); });
      pts.appendChild(b);
    });
    var marcar = function(){ var i = Math.round(s.scrollLeft / (s.clientWidth || 1)); [].forEach.call(pts.children, function(b, k){ b.setAttribute("aria-current", k === i); }); };
    s.addEventListener("scroll", function(){ requestAnimationFrame(marcar); }, {passive: true}); marcar();
  }
  // vídeos: só tocam quando estão no ecrã; o do topo escolhe a versão do telemóvel ou do computador
  // escova de oferta: ver em grande
  (function(){
    var d = document.getElementById("lj-escova-dlg"); if (!d || !d.showModal) return;
    [].forEach.call(document.querySelectorAll("[data-escova]"), function(b){ b.addEventListener("click", function(e){ e.preventDefault(); d.showModal(); }); });
    d.addEventListener("click", function(e){ if (e.target === d) d.close(); });
  })();
  // prazo de entrega (modo "encomenda", em teste): encomendas até às 17:00 (hora de Lisboa) num dia útil saem nesse dia e chegam no dia útil seguinte.
  // modo "pre" (pré-encomenda): envio em até N dias + 2 a 4 dias úteis CTT, conta até à meia-noite.
  (function(){
    var box = document.querySelector(".lj-prazo"); if (!box) return;
    var modo = box.dataset.modo || "pre", corte = +box.dataset.corte || 17, dias = +box.dataset.dias || 10;
    var L = window.ONDAO_LJ, DIAS = L.dias.split("|"), PAIS = box.dataset.pais || "PT";
    var dd = function(n){ return (n < 10 ? "0" : "") + n; };
    var fmt = function(d){ return DIAS[d.getDay()] + ", " + dd(d.getDate()) + "/" + dd(d.getMonth() + 1); };
    function lisboa(){ // hora de Lisboa, como data "local"
      var p = {}; new Intl.DateTimeFormat("en-GB", {timeZone: "Europe/Lisbon", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23"}).formatToParts(new Date()).forEach(function(x){ p[x.type] = x.value; });
      return new Date(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute, +p.second);
    }
    var util = function(d){ var w = d.getDay(); return w !== 0 && w !== 6; };
    var proxUtil = function(d){ var n = new Date(d); do { n.setDate(n.getDate() + 1); } while (!util(n)); return n; };
    var mesmoDia = function(a, b){ return a.toDateString() === b.toDateString(); };
    function pintar(){
      var agora = lisboa(), limite, envio, entrega;
      if (modo === "encomenda"){
        limite = new Date(agora); limite.setHours(corte, 0, 0, 0);
        if (!util(agora) || agora >= limite){ limite = proxUtil(agora); limite.setHours(corte, 0, 0, 0); }
        envio = new Date(limite); envio.setHours(0,0,0,0); entrega = proxUtil(envio);
      } else {
        limite = new Date(agora); limite.setHours(24, 0, 0, 0);
        envio = new Date(agora); envio.setHours(0,0,0,0); envio.setDate(envio.getDate() + dias);
        entrega = new Date(envio); for (var u = 0; u < 4;){ entrega.setDate(entrega.getDate() + 1); if (util(entrega)) u++; }
      }
      var hoje = new Date(agora); hoje.setHours(0,0,0,0); var amanha = new Date(hoje); amanha.setDate(amanha.getDate() + 1);
      var min = Math.max(1, Math.ceil((limite - agora) / 60000)), h = Math.floor(min / 60), m = min % 60;
      var topoTxt = box.querySelector(".lj-prazo-topo"), conta = box.querySelector("[data-prazo-conta]");
      if (modo !== "encomenda" || mesmoDia(limite, agora)){
        topoTxt.querySelector("[data-t1]").textContent = L.t1_proximas;
        conta.textContent = (h ? h + " h" + (m ? " " : "") : "") + (m || !h ? m + " min" : "");
      } else {
        var diaLimite = new Date(limite); diaLimite.setHours(0,0,0,0);
        topoTxt.querySelector("[data-t1]").textContent = L.t1_ate;
        conta.textContent = (mesmoDia(diaLimite, amanha) ? L.amanha : DIAS[limite.getDay()]) + L.as_ + corte + ":00";
      }
      var nome = function(d){ return mesmoDia(d, hoje) ? L.hoje : (mesmoDia(d, amanha) ? L.amanha + ", " + fmt(d) : fmt(d)); };
      var fora = PAIS !== "PT";
      topoTxt.querySelector("[data-t2]").textContent = fora ? L.t2_envio : L.t2_receba;
      var pre = modo === "encomenda" ? "" : L.ate;
      var cap = function(t){ return t.charAt(0).toUpperCase() + t.slice(1); };
      box.querySelector("[data-prazo-envio]").textContent = cap(pre + nome(envio));
      box.querySelector("[data-prazo-entrega]").textContent = fora ? L.checkout : cap(pre + nome(entrega));
      var heroP = document.querySelector("[data-prazo-hero]");
      if (heroP) heroP.textContent = fora ? L.hero_envio + nome(envio).replace(/, \d\d\/\d\d$/, "") : (modo === "encomenda" ? L.hero_receba : L.entrega_ate) + nome(entrega).replace(/, \d\d\/\d\d$/, "");
      box.querySelector("[data-prazo-entrega-curta]").textContent = fora ? nome(envio) : (modo === "encomenda" ? "" : L.ate) + nome(entrega);
    }
    pintar(); setInterval(pintar, 30000);
  })();
  var calmo = matchMedia("(prefers-reduced-motion: reduce)").matches;
  var topo = document.getElementById("lj-video-topo");
  var ligacao = navigator.connection || {};
  var poupar = ligacao.saveData || /(^|-)2g|3g/.test(ligacao.effectiveType || "");
  if (topo && !calmo && !poupar) {
    // a foto do topo aparece primeiro; o vídeo só começa a descarregar depois de a página carregar
    var arrancar = function(){ setTimeout(function(){
      var src = matchMedia("(min-width: 900px), (orientation: landscape) and (min-width: 600px)").matches ? topo.dataset.computador : topo.dataset.telemovel;
      if (!src) return;
      topo.src = src;
      topo.addEventListener("canplay", function(){ topo.classList.add("pronto"); topo.play().catch(function(){}); }, {once: true});
      topo.preload = "auto"; topo.load();
    }, 800); };
    // arranca depois de a página carregar, mas nunca espera mais de 3 s (scripts externos podem atrasar o "load")
    var feito = false, uma = function(){ if (!feito) { feito = true; arrancar(); } };
    if (document.readyState === "complete") uma(); else { window.addEventListener("load", uma, {once: true}); setTimeout(uma, 3000); }
  }
  // se o browser recusar o arranque automático (poupança de energia, definições), tenta outra vez ao primeiro toque ou scroll
  var pendentes = [];
  var tocar = function(v){ var pr = v.play(); if (pr && pr.catch) pr.catch(function(){ if (pendentes.indexOf(v) < 0) pendentes.push(v); }); };
  var retomar = function(){ pendentes.splice(0).forEach(function(v){ if (v.dataset.visivel === "1") tocar(v); }); };
  ["touchstart", "pointerdown", "keydown", "scroll"].forEach(function(ev){ window.addEventListener(ev, retomar, {passive: true}); });
  if (topo) topo.addEventListener("canplay", function(){ if (topo.paused) tocar(topo); });
  if ("IntersectionObserver" in window && !calmo) {
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){ var v = e.target; v.dataset.visivel = e.isIntersecting ? "1" : "0"; if (!v.getAttribute("src")) return; if (e.isIntersecting) { tocar(v); } else { v.pause(); } }); }, {threshold: .25});
    [].forEach.call(document.querySelectorAll(".lj video.lj-video"), function(v){ if (!v.controls) io.observe(v); });
  }
  // quantidade: 1 ou 2 tubos atualiza todos os botões de compra, o Shop Pay e o preço do botão fixo
  var qtds = document.querySelectorAll('input[name="lj-qtd"]');
  if (qtds.length) {
    var base = {{ link | json }}.replace(/:\d+$/, ""), totais = {1: {{ preco | json }}, 2: {{ preco2 | json }}};
    var aplicar = function(){
      var q = document.querySelector('input[name="lj-qtd"]:checked').value;
      [].forEach.call(document.querySelectorAll("[data-lj-cta]"), function(a){ a.href = base + ":" + q; });
      var ex = document.getElementById("lj-qtd-express"); if (ex) ex.value = q;
      [].forEach.call(document.querySelectorAll("[data-lj-total]"), function(t){ t.textContent = totais[q]; });
    };
    [].forEach.call(qtds, function(r){ r.addEventListener("change", aplicar); });
    aplicar();
  }
  // botão fixo: aparece quando o botão de compra sai do ecrã
  var fixa = document.getElementById("lj-fixa"), comprar = document.getElementById("lj-comprar");
  if (fixa && comprar && "IntersectionObserver" in window) {
    new IntersectionObserver(function(es){ var e = es[0]; fixa.classList.toggle("on", !e.isIntersecting && e.boundingClientRect.top < 0); }).observe(comprar);
  }
  // newsletter
  var f = document.getElementById("lj-news"), m = document.getElementById("lj-msg");
  if (f) f.addEventListener("submit", async function(e){
    e.preventDefault();
    if (!/^\S+@\S+\.\S+$/.test(f.email.value.trim())) { m.textContent = window.ONDAO_LJ.news_email; return; }
    if (!f.consent.checked) { m.textContent = window.ONDAO_LJ.news_consent; return; }
    m.textContent = "A inscrever…";
    try {
      var r = await fetch("https://formspree.io/f/xqpegzwz", {method: "POST", body: new FormData(f), headers: {Accept: "application/json"}});
      if (!r.ok) throw 0;
      f.reset(); m.textContent = window.ONDAO_LJ.news_ok;
    } catch(err) { m.textContent = window.ONDAO_LJ.news_falhou; }
  });
})();
</script>

{%- if e_produto and p != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p.title | json }},
  "image": [{{ 'ondao-02-galeria-1.jpg' | asset_url | prepend: 'https:' | json }}],
  "description": {{ 'ondao.loja.schema_desc' | t | json }},
  "brand": {"@type": "Brand", "name": "ondão"},
  {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: p.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ v.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    "shippingDetails": [{
      "@type": "OfferShippingDetails",
      "shippingDestination": {"@type": "DefinedRegion", "addressCountry": "PT"},
      "shippingRate": {"@type": "MonetaryAmount", "value": 4.5, "currency": "EUR"},
      "deliveryTime": {"@type": "ShippingDeliveryTime",
        "handlingTime": {"@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY"},
        "transitTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 1, "unitCode": "DAY"}}
    }],
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "PT",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": {{ dev | default: 14 }},
      "returnMethod": "https://schema.org/ReturnByMail"
    }
  }
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Loja ondão",
  "settings": [
    {"type": "product", "id": "produto", "label": "Produto à venda"},
    {"type": "number", "id": "dias_preparacao", "label": "Dias até enviar (a contar do pagamento)", "default": 10},
    {"type": "number", "id": "dias_devolucao", "label": "Dias para devolver (a contar da entrega)", "default": 14},
    {"type": "text", "id": "portes_pt", "label": "Portes em Portugal (€, como aparece no site)", "default": "4,50"},
    {"type": "number", "id": "portes_gratis", "label": "Portes grátis a partir de (€)", "default": 35}
  ],
  "presets": [{"name": "Loja ondão"}]
}
{% endschema %}
